# IRB baseline webhook bridge config — copy to .env and fill in.

IRB_WEBHOOK_SECRET=REPLACE_ME_32_PLUS_HEX_CHARS

METAAPI_TOKEN=REPLACE_ME_METAAPI_JWT
METAAPI_ACCOUNT_ID=REPLACE_ME_ACCOUNT_UUID
METAAPI_REGION=london

IRB_SYMBOL=EURUSD

# Risk-based sizing: lot = equity * IRB_RISK_PCT/100 / (IRB_CONTRACT_SIZE * |entry-stop|)
IRB_RISK_PCT=1.0
IRB_CONTRACT_SIZE=100000
IRB_MIN_LOT=0.01
IRB_MAX_LOT=50.0
IRB_LOT_STEP=0.01
# Fallback lot when equity/entry/stop are unavailable (logs a WARNING):
IRB_BASE_LOT=0.10

IRB_BIND_HOST=127.0.0.1
IRB_BIND_PORT=8081

# Equity used when IRB_DRY_RUN=true:
IRB_DRY_EQUITY=100000
IRB_DRY_RUN=true
