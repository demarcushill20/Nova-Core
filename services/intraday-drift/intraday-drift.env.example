# Intraday EUR-weakness drift — demo executor env.
# Copy to /etc/novacore/intraday-drift.env (operator, root), fill in, then flip DRY_RUN.
# NEVER commit the filled-in file — it holds the MetaApi token. This .example has placeholders.

# --- MetaApi (a DEDICATED demo account, separate from IRB 372f9c3d + month-end) ---
METAAPI_TOKEN=<your-metaapi-token>
METAAPI_ACCOUNT_ID=<dedicated-demo-account-id>
METAAPI_REGION=london

# --- execution mode ---
# Start with true (paper, no orders) to confirm logs, then set false to trade the demo.
IDF_DRY_RUN=true

# --- strategy params (backtested defaults — do NOT change live without re-running the gauntlet) ---
IDF_STOP_PIPS=20        # 20p stop ≈ 8% CAGR / -19% DD ; 15p ≈ 11% / -22% (tighter = more of both)
IDF_RISK_FRAC=0.01      # 1% of equity risked per trade
IDF_ENTRY_HOUR_UTC=11   # SHORT EURUSD at 11:00 UTC
IDF_EXIT_HOUR_UTC=12    # flat at 12:00 UTC
IDF_POLL_SECONDS=60
IDF_PAPER_EQUITY=100000 # sizing equity used only in dry-run
