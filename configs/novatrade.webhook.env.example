# configs/novatrade.webhook.env — TEMPLATE for the second runner instance
#
# Operator copies this to /etc/novacore/novatrade-webhook.env (mode 600,
# owner nova) and fills the three "fill-at-deploy" values before enabling
# the systemd unit `novacore-novatrade-webhook.service`. See:
#   docs/operator/webhook-demo-runbook.md  for full deployment steps
#   docs/superpowers/specs/2026-04-30-tv-webhook-demo-pipeline-design.md  for design

NOVATRADE_LAUNCH_MODE=active_ready
NOVATRADE_PIPELINE=webhook
NOVATRADE_DRY_RUN=false
NOVATRADE_PORT=8878
NOVATRADE_HOST=0.0.0.0
NOVATRADE_MONITOR_INTERVAL=60

# MetaApi cloud — IC Markets cTrader Demo (operator provisions via metaapi.cloud).
METAAPI_TOKEN=fill-at-deploy
METAAPI_ACCOUNT_ID=fill-at-deploy
METAAPI_REGION=london

# FTMO-style risk profile (we keep full FTMO guards on this demo per spec D5).
FTMO_ENABLED=true
FTMO_CHALLENGE_TYPE=free_trial
FTMO_CAMPAIGN_LABEL=ic-markets-demo-2026-q2
FTMO_ACCOUNT_SIZE=100000
FTMO_SYMBOL_SUFFIX=

# Webhook secret — must match WH_SECRET literal in irb_v5_m5_webhook.pine
# (operator patches the Pine literal in TV editor at deploy time).
NOVATRADE_WEBHOOK_SECRET=fill-at-deploy

# Pre-flight confirmations (operator-acknowledged once per launch).
NOVATRADE_CONFIRM_PINE_COMPILED=true
NOVATRADE_CONFIRM_TV_BACKTEST=true
NOVATRADE_CONFIRM_WEBHOOK_URL=true
NOVATRADE_CONFIRM_ACTIVE_DEMO=true

# Strategy YAML — same as champion runner (strategy logic is identical).
NOVATRADE_STRATEGY_CONFIG=/home/nova/nova-core/configs/strategies/irb_v5_m5_champion.yaml
NOVATRADE_TIMEFRAMES=M5
