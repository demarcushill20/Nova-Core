//@version=6
strategy("IRB v2 Seed2024 (London)", overlay=true, default_qty_type=strategy.fixed, default_qty_value=100000, initial_capital=100000.0, commission_type=strategy.commission.cash_per_order, commission_value=7.0)

// === INPUTS ===
irb_threshold    = input.float(0.5793, "IRB Threshold", step=0.01)
ema_period       = input.int(35, "EMA Period", minval=1)
ema_fast_period  = input.int(6, "EMA Fast", minval=1)
ema_slow_period  = input.int(41, "EMA Slow", minval=1)
atr_period       = input.int(20, "ATR Period", minval=1)
adx_period       = input.int(8, "ADX Period", minval=1)
slope_thresh     = input.float(0.3300, "Trend Slope Threshold", step=0.01)
adx_thresh       = input.float(28.18, "ADX Threshold", step=0.5)
overext_thresh   = input.float(2.456, "Overextension Threshold", step=0.1)
trail_ema_period = input.int(42, "Trail EMA Period", minval=1)
confirm_bars     = input.int(2, "EMA Confirm Bars", minval=0)
trigger_window   = input.int(38, "Trigger Window Bars", minval=1)
time_stop        = input.int(25, "Time Stop Bars", minval=1)
mtf_lookback     = input.int(38, "MTF Lookback (H4 bars)", minval=1)
warmup_bars      = input.int(56, "Warmup Bars", minval=0)
pip_buffer       = input.float(0.0001, "Pip Buffer", step=0.0001)

// === SESSION FILTER (London: 07:00-16:00 UTC) ===
london_session = input.session("0700-1600", "London Session")
in_session = not na(time(timeframe.period, london_session, "UTC"))

// === INDICATORS (H1 timeframe) ===
ema_main  = ta.ema(close, ema_period)
ema_f     = ta.ema(close, ema_fast_period)
ema_s     = ta.ema(close, ema_slow_period)
atr_val   = ta.atr(atr_period)
trail_ema = ta.ema(close, trail_ema_period)
[diplus, diminus, adx_val] = ta.dmi(adx_period, adx_period)

// === H4 EMA (MTF alignment) ===
ema_h4 = request.security(syminfo.tickerid, "240", ta.ema(close, ema_period))

// === TREND SLOPE ===
slope_lookback = math.min(20, bar_index)
ema_slope = slope_lookback >= 1 and nz(atr_val) > 0 ? (ema_main - ema_main[slope_lookback]) / atr_val : 0.0

// === IRB DETECTION (Python-matching geometry) ===
// Python: up_threshold = high - (irb_threshold * range)
//         is_uptrend_irb = open <= up_threshold AND close <= up_threshold
bar_range = high - low
up_thresh_price = high - (irb_threshold * bar_range)
dn_thresh_price = low  + (irb_threshold * bar_range)
bullish_irb = bar_range > 0 and open <= up_thresh_price and close <= up_thresh_price
bearish_irb = bar_range > 0 and open >= dn_thresh_price and close >= dn_thresh_price

// === OVEREXTENSION FILTER (Python-matching: bar_range / ATR) ===
overext_ratio = nz(atr_val) > 0 ? bar_range / atr_val : 0.0
overextended  = overext_ratio > overext_thresh

// === EMA CONFIRM (checks close vs ema_fast) ===
bars_above = 0
bars_below = 0
if confirm_bars > 0
    for i = 0 to confirm_bars - 1
        if close[i] > ema_f[i]
            bars_above += 1
        if close[i] < ema_f[i]
            bars_below += 1
ema_confirmed_bull = bars_above >= confirm_bars
ema_confirmed_bear = bars_below >= confirm_bars

// === TREND + ADX CONDITIONS ===
trending      = adx_val >= adx_thresh
bullish_trend = ema_slope >= slope_thresh and trending
bearish_trend = ema_slope <= -slope_thresh and trending

// === MTF ALIGNMENT ===
h4_rising  = not na(ema_h4) and ema_h4 > ema_h4[mtf_lookback]
h4_falling = not na(ema_h4) and ema_h4 < ema_h4[mtf_lookback]

// === WARMUP ===
past_warmup = bar_index >= warmup_bars

// === SIGNAL (current bar IRB only — NO backward scanning) ===
long_signal  = past_warmup and in_session and bullish_irb and bullish_trend and not overextended and ema_confirmed_bull and h4_rising
short_signal = past_warmup and in_session and bearish_irb and bearish_trend and not overextended and ema_confirmed_bear and h4_falling

// === PENDING ORDER STATE ===
var int   order_bar = na
var float init_sl   = na

// Cancel expired pending orders
if not na(order_bar) and strategy.position_size == 0 and (bar_index - order_bar) >= trigger_window
    strategy.cancel_all()
    order_bar := na
    init_sl   := na

// === ENTRY: PENDING STOP ORDERS ===
if strategy.position_size == 0
    if long_signal
        strategy.entry("Long", strategy.long, stop=high + pip_buffer)
        order_bar := bar_index
        init_sl   := low - pip_buffer
    else if short_signal
        strategy.entry("Short", strategy.short, stop=low - pip_buffer)
        order_bar := bar_index
        init_sl   := high + pip_buffer

// === TRAILING STOP MANAGEMENT (ratcheting) ===
var float trail_stop = na

// Initialize on position open
if strategy.position_size != 0 and strategy.position_size[1] == 0
    trail_stop := init_sl
    order_bar  := na

// Ratchet trail stop (only tightens)
if strategy.position_size > 0
    if not na(trail_ema) and trail_ema > nz(trail_stop, 0)
        trail_stop := trail_ema
    strategy.exit("Long Exit", "Long", stop=trail_stop)

if strategy.position_size < 0
    if not na(trail_ema) and trail_ema < nz(trail_stop, 99999)
        trail_stop := trail_ema
    strategy.exit("Short Exit", "Short", stop=trail_stop)

// === TIME STOP ===
if strategy.position_size != 0
    int entry_bar = strategy.opentrades.entry_bar_index(0)
    if not na(entry_bar) and (bar_index - entry_bar) >= time_stop
        strategy.close_all(comment="Time Stop")
        trail_stop := na

// Reset on position close
if strategy.position_size == 0 and strategy.position_size[1] != 0
    trail_stop := na

// === PLOTS ===
plot(ema_main, title="EMA Main", color=color.yellow, linewidth=2)
plot(ema_f, title="EMA Fast", color=color.green)
plot(ema_s, title="EMA Slow", color=color.red)
plot(trail_ema, title="Trail EMA", color=color.orange, style=plot.style_stepline)
bgcolor(in_session ? color.new(color.blue, 95) : na, title="London Session")
plot(strategy.position_size > 0 ? trail_stop : na, title="Long Stop", color=color.red, style=plot.style_circles, linewidth=2)
plot(strategy.position_size < 0 ? trail_stop : na, title="Short Stop", color=color.red, style=plot.style_circles, linewidth=2)
plotshape(long_signal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(short_signal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
