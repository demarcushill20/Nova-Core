// @version=5

// =============================================================================

// NovaTrade Rob Hoffman IRB — Pine Implementation

// =============================================================================



strategy(

     "NovaTrade IRB v4.0.0",

     overlay            = true,

     default_qty_type   = strategy.fixed,

     default_qty_value  = 10000,

     initial_capital    = 100000,

     currency           = currency.USD,

     pyramiding         = 0,

     process_orders_on_close = false,

     calc_on_every_tick = false,

     max_bars_back      = 500)



// =============================================================================

// SECTION 1: CONSTANTS / INPUTS

// =============================================================================



// --- IRB Geometry ---

IRB_PCT            = 0.45



// --- Indicator Periods ---

EMA_FAST_PERIOD    = 10

EMA_PERIOD         = 20

EMA_SLOW_PERIOD    = 50

ATR_PERIOD         = 14

ADX_PERIOD         = 14



// --- Entry Filters ---

EMA_CONFIRM_BARS   = input.int(3, "Bars Closing Above/Below EMA 10", minval = 1, group = "Entry Filters")



// --- Trend Filter ---

SLOPE_LOOKBACK     = 20

SLOPE_THRESH       = 0.4



// --- MTF Alignment ---

MTF_H1_LOOKBACK    = 20



// --- Sideways Filter ---

ADX_THRESH         = 20



// --- Overextension Filter ---

OE_THRESH          = 2.0



// --- Entry / SL Buffer ---

PIP_BUF            = 0.0001



// --- Trigger Window ---

TRIGGER_WIN        = 20



// --- Exit Management ---

TRAIL_EMA_PERIOD   = input.int(40, "Trailing Stop EMA Period", minval = 1, group = "Exit Management")

TIME_STOP          = 40



// --- v4 Stagnation Guard ---

USE_STAG   = input.bool(true, "Use Stagnation Guard", group = "v4 Stagnation Guard")

STAG_BARS  = input.int(8, "Stagnation Check Bar", minval = 3, maxval = 20, group = "v4 Stagnation Guard")

STAG_ATR   = input.float(0.5, "Stagnation ATR Threshold", minval = 0.1, maxval = 2.0, step = 0.1, group = "v4 Stagnation Guard")



// --- Position Sizing ---

RISK_PCT           = 0.01

MIN_LOTS           = 0.01

MAX_LOTS           = 1.00

PIP_VAL_LOT        = 10.0



// --- Warmup ---

WARMUP             = 50



// --- Metadata ---

STRAT_NAME         = "Rob Hoffman IRB"

STRAT_VER          = "4.0.0"

CAMPAIGN           = "ftmo-free-trial-march-2026"

WH_SECRET          = "d69eadb4a7ca9fc6c32c3551783dc3145eab812fac8b4a7c67a9753e87e4cc67"



// =============================================================================

// SECTION 2: DERIVED CONSTANTS

// =============================================================================



pip_size       = syminfo.mintick * 10

units_per_lot  = 100000



// =============================================================================

// SECTION 3: INDICATORS

// =============================================================================



ema_10_h1 = ta.ema(close, EMA_FAST_PERIOD)

ema_h1    = ta.ema(close, EMA_PERIOD)

ema_50_h1 = ta.ema(close, EMA_SLOW_PERIOD)



trail_ema = ta.ema(close, TRAIL_EMA_PERIOD)



atr_val = ta.atr(ATR_PERIOD)

[dp, dm, adx_val] = ta.dmi(ADX_PERIOD, ADX_PERIOD)



ema_h4 = request.security(

     syminfo.tickerid,

     "240",

     ta.ema(close, EMA_PERIOD),

     lookahead = barmerge.lookahead_off)



// Visual: EMA lines

plot(ema_10_h1, "EMA 10 H1", color.new(color.green, 0), 2)

plot(ema_h1,    "EMA 20 H1", color.new(color.blue, 0), 2)

plot(ema_50_h1, "EMA 50 H1", color.new(color.purple, 0), 2)

plot(trail_ema, "Trailing Stop EMA", color.new(color.yellow, 0), 2)



// =============================================================================

// SECTION 4: HELPER FUNCTIONS

// =============================================================================



f_all_closes_above(src, ref, bars) =>

    bool ok = true

    for i = 0 to bars - 1

        ok := ok and not na(src[i]) and not na(ref[i]) and src[i] > ref[i]

    ok



f_all_closes_below(src, ref, bars) =>

    bool ok = true

    for i = 0 to bars - 1

        ok := ok and not na(src[i]) and not na(ref[i]) and src[i] < ref[i]

    ok



f_qty(float ep, float sp) =>

    float sd  = math.abs(ep - sp) / pip_size

    float rd  = strategy.equity * RISK_PCT

    float raw = sd > 0 ? rd / (sd * PIP_VAL_LOT) : MIN_LOTS

    float cl  = math.max(MIN_LOTS, math.min(MAX_LOTS, raw))

    float rnd = math.round(cl * 100.0) / 100.0

    rnd * units_per_lot



// =============================================================================

// SECTION 5: WARMUP GUARD

// =============================================================================



warmup_ok = bar_index >= math.max(WARMUP, math.max(EMA_CONFIRM_BARS, TRAIL_EMA_PERIOD))



// =============================================================================

// SECTION 6: IRB GEOMETRY DETECTION

// =============================================================================



bar_rng   = high - low

valid_rng = bar_rng > 0



up_thresh = high - IRB_PCT * bar_rng

is_up_irb = valid_rng and (open <= up_thresh) and (close <= up_thresh)



dn_thresh = low + IRB_PCT * bar_rng

is_dn_irb = valid_rng and (open >= dn_thresh) and (close >= dn_thresh)



// =============================================================================

// SECTION 7: TREND FILTER

// =============================================================================



ema_slope = nz(atr_val) > 0 ? (ema_h1 - nz(ema_h1[SLOPE_LOOKBACK])) / atr_val : 0.0



trend_up = ema_slope >= SLOPE_THRESH

trend_dn = ema_slope <= -SLOPE_THRESH



// =============================================================================

// SECTION 8: MTF ALIGNMENT

// =============================================================================



h4_up = not na(ema_h4) and not na(ema_h4[MTF_H1_LOOKBACK]) and (ema_h4 > ema_h4[MTF_H1_LOOKBACK])

h4_dn = not na(ema_h4) and not na(ema_h4[MTF_H1_LOOKBACK]) and (ema_h4 < ema_h4[MTF_H1_LOOKBACK])



// =============================================================================

// SECTION 9: SIDEWAYS FILTER

// =============================================================================



sw_pass = adx_val >= ADX_THRESH



// =============================================================================

// SECTION 10: OVEREXTENSION FILTER

// =============================================================================



oe_ratio = nz(atr_val) > 0 ? bar_rng / atr_val : 0.0

oe_pass  = oe_ratio <= OE_THRESH



// =============================================================================

// SECTION 11: EMA STACK FILTER

// =============================================================================



ema_stack_bull = ema_10_h1 > ema_h1 and ema_h1 > ema_50_h1

ema_stack_bear = ema_10_h1 < ema_h1 and ema_h1 < ema_50_h1



// =============================================================================

// SECTION 12: EMA CLOSE CONFIRMATION FILTER

// =============================================================================



ema10_confirm_long  = f_all_closes_above(close, ema_10_h1, EMA_CONFIRM_BARS)

ema10_confirm_short = f_all_closes_below(close, ema_10_h1, EMA_CONFIRM_BARS)



// =============================================================================

// SECTION 13: COMBINED SIGNAL

// =============================================================================



sig_long  = warmup_ok and is_up_irb and trend_up and h4_up and sw_pass and oe_pass and ema_stack_bull and ema10_confirm_long

sig_short = warmup_ok and is_dn_irb and trend_dn and h4_dn and sw_pass and oe_pass and ema_stack_bear and ema10_confirm_short



// =============================================================================

// SECTION 14: STATE MACHINE

// =============================================================================



int S_FLAT   = 0

int S_PLONG  = 1

int S_PSHORT = 2

int S_LONG   = 3

int S_SHORT  = 4



var int   state     = S_FLAT

var float irb_hi    = na

var float irb_lo    = na

var int   pend_bars = 0

var int   pos_bars  = 0

var float best_cl   = na

var float cur_stop  = na

var float pend_qty  = na

var float entry_atr  = na

var float peak_fav   = na



bool was_flat  = strategy.position_size[1] == 0

bool now_long  = strategy.position_size > 0

bool now_short = strategy.position_size < 0

bool now_flat  = strategy.position_size == 0



bool fill_long  = now_long and was_flat

bool fill_short = now_short and was_flat

bool pos_closed = now_flat and not was_flat



bool evt_signal  = false

bool evt_replace = false

bool evt_cancel  = false

bool evt_tstop   = false

bool evt_stag    = false

string evt_side  = ""



// --- Position closed → FLAT ---

if pos_closed

    state     := S_FLAT

    irb_hi    := na

    irb_lo    := na

    pend_bars := 0

    pos_bars  := 0

    best_cl   := na

    cur_stop  := na

    pend_qty  := na

    entry_atr := na

    peak_fav  := na



// --- Fill detected → LONG ---

if fill_long and state == S_PLONG

    state    := S_LONG

    pos_bars := 0

    best_cl  := close

    cur_stop := irb_lo - PIP_BUF

    entry_atr := atr_val

    peak_fav  := 0.0



// --- Fill detected → SHORT ---

if fill_short and state == S_PSHORT

    state    := S_SHORT

    pos_bars := 0

    best_cl  := close

    cur_stop := irb_hi + PIP_BUF

    entry_atr := atr_val

    peak_fav  := 0.0



// --- Increment counters ---

if state == S_PLONG or state == S_PSHORT

    pend_bars += 1

if state == S_LONG or state == S_SHORT

    pos_bars += 1



// =============================================================================

// SECTION 15: PENDING ORDER MANAGEMENT

// =============================================================================



// --- Trigger window expiry ---

if state == S_PLONG and pend_bars >= TRIGGER_WIN

    strategy.cancel("Long")

    state      := S_FLAT

    irb_hi     := na

    irb_lo     := na

    pend_bars  := 0

    pend_qty   := na

    evt_cancel := true

    evt_side   := "BUY"



if state == S_PSHORT and pend_bars >= TRIGGER_WIN

    strategy.cancel("Short")

    state      := S_FLAT

    irb_hi     := na

    irb_lo     := na

    pend_bars  := 0

    pend_qty   := na

    evt_cancel := true

    evt_side   := "SELL"



// --- New signal from FLAT ---

if state == S_FLAT and sig_long

    float ep = high + PIP_BUF

    float sp = low  - PIP_BUF

    float qv = f_qty(ep, sp)

    strategy.entry("Long", strategy.long, stop = ep, qty = qv)

    irb_hi     := high

    irb_lo     := low

    pend_qty   := qv

    state      := S_PLONG

    pend_bars  := 0

    evt_signal := true

    evt_side   := "BUY"



else if state == S_FLAT and sig_short

    float ep = low  - PIP_BUF

    float sp = high + PIP_BUF

    float qv = f_qty(ep, sp)

    strategy.entry("Short", strategy.short, stop = ep, qty = qv)

    irb_hi     := high

    irb_lo     := low

    pend_qty   := qv

    state      := S_PSHORT

    pend_bars  := 0

    evt_signal := true

    evt_side   := "SELL"



// --- Same-direction replacement while pending ---

else if state == S_PLONG and sig_long

    float ep = high + PIP_BUF

    float sp = low  - PIP_BUF

    float qv = f_qty(ep, sp)

    strategy.entry("Long", strategy.long, stop = ep, qty = qv)

    irb_hi      := high

    irb_lo      := low

    pend_qty    := qv

    pend_bars   := 0

    evt_replace := true

    evt_side    := "BUY"



else if state == S_PSHORT and sig_short

    float ep = low  - PIP_BUF

    float sp = high + PIP_BUF

    float qv = f_qty(ep, sp)

    strategy.entry("Short", strategy.short, stop = ep, qty = qv)

    irb_hi      := high

    irb_lo      := low

    pend_qty    := qv

    pend_bars   := 0

    evt_replace := true

    evt_side    := "SELL"



// =============================================================================

// SECTION 16: EXIT MANAGEMENT

// =============================================================================



// --- LONG EMA trailing stop + stagnation guard + time stop ---

if state == S_LONG

    best_cl := math.max(nz(best_cl, close), close)

    peak_fav := math.max(nz(peak_fav, 0.0), high - strategy.position_avg_price)



    float ema_stop_long = trail_ema



    cur_stop := math.max(nz(cur_stop, ema_stop_long), ema_stop_long)



    strategy.exit("Long Exit", "Long", stop = cur_stop)



    if USE_STAG and pos_bars == STAG_BARS and not na(entry_atr) and entry_atr > 0

        if nz(peak_fav, 0.0) < STAG_ATR * entry_atr

            strategy.close("Long", comment = "STAG_EXIT")

            evt_stag := true

            evt_side := "BUY"



    if not evt_stag and pos_bars >= TIME_STOP

        strategy.close("Long", comment = "TIME_STOP")

        evt_tstop := true

        evt_side  := "BUY"



// --- SHORT EMA trailing stop + stagnation guard + time stop ---

if state == S_SHORT

    best_cl := math.min(nz(best_cl, close), close)

    peak_fav := math.max(nz(peak_fav, 0.0), strategy.position_avg_price - low)



    float ema_stop_short = trail_ema



    cur_stop := math.min(nz(cur_stop, ema_stop_short), ema_stop_short)



    strategy.exit("Short Exit", "Short", stop = cur_stop)



    if USE_STAG and pos_bars == STAG_BARS and not na(entry_atr) and entry_atr > 0

        if nz(peak_fav, 0.0) < STAG_ATR * entry_atr

            strategy.close("Short", comment = "STAG_EXIT")

            evt_stag := true

            evt_side := "SELL"



    if not evt_stag and pos_bars >= TIME_STOP

        strategy.close("Short", comment = "TIME_STOP")

        evt_tstop := true

        evt_side  := "SELL"



// =============================================================================

// SECTION 17: ALERT PAYLOADS

// =============================================================================



// --- Signal / Replace alert ---

if evt_signal or evt_replace

    string at = evt_replace ? "REPLACE_STOP_ORDER" : "PLACE_STOP_ORDER"

    string it = evt_side == "BUY" ? "UPTREND_IRB" : "DOWNTREND_IRB"

    string st = evt_side == "BUY" ? "LONG_IRB" : "SHORT_IRB"

    string ot = evt_side == "BUY" ? "BUY_STOP" : "SELL_STOP"

    float ep  = evt_side == "BUY" ? irb_hi + PIP_BUF : irb_lo - PIP_BUF

    float sp  = evt_side == "BUY" ? irb_lo - PIP_BUF : irb_hi + PIP_BUF

    float sd  = math.abs(ep - sp) / pip_size

    float rd  = strategy.equity * RISK_PCT

    float vol = math.max(MIN_LOTS, math.min(MAX_LOTS, sd > 0 ? rd / (sd * PIP_VAL_LOT) : MIN_LOTS))

    vol := math.round(vol * 100.0) / 100.0



    string p = "{" +

         "\"webhook_secret\":\""      + WH_SECRET + "\"" +

         ",\"strategy_name\":\""      + STRAT_NAME + "\"" +

         ",\"strategy_version\":\""   + STRAT_VER + "\"" +

         ",\"action\":\""             + at + "\"" +

         ",\"signal_type\":\""        + st + "\"" +

         ",\"irb_type\":\""           + it + "\"" +

         ",\"symbol\":\"EURUSD\"" +

         ",\"broker_symbol\":\"EURUSD.sim\"" +

         ",\"timeframe\":\"H1\"" +

         ",\"side\":\""               + evt_side + "\"" +

         ",\"order_type\":\""         + ot + "\"" +

         ",\"entry_price\":"          + str.tostring(ep, "#.#####") +

         ",\"stop_loss\":"            + str.tostring(sp, "#.#####") +

         ",\"stop_distance_pips\":"   + str.tostring(sd, "#.#") +

         ",\"volume\":"               + str.tostring(vol, "#.##") +

         ",\"risk_dollars\":"         + str.tostring(rd, "#.##") +

         ",\"bar_close_time\":"       + str.tostring(time_close) +

         ",\"bar_ohlc_o\":"           + str.tostring(open, "#.#####") +

         ",\"bar_ohlc_h\":"           + str.tostring(high, "#.#####") +

         ",\"bar_ohlc_l\":"           + str.tostring(low, "#.#####") +

         ",\"bar_ohlc_c\":"           + str.tostring(close, "#.#####") +

         ",\"irb_range\":"            + str.tostring(bar_rng, "#.#####") +

         ",\"ema_10_h1\":"            + str.tostring(ema_10_h1, "#.#####") +

         ",\"ema_20_h1\":"            + str.tostring(ema_h1, "#.#####") +

         ",\"ema_50_h1\":"            + str.tostring(ema_50_h1, "#.#####") +

         ",\"trail_ema\":"            + str.tostring(trail_ema, "#.#####") +

         ",\"trail_ema_period\":"     + str.tostring(TRAIL_EMA_PERIOD) +

         ",\"ema_stack_h1\":\""       + (ema_stack_bull ? "BULL" : ema_stack_bear ? "BEAR" : "MIXED") + "\"" +

         ",\"ema_confirm_bars\":"     + str.tostring(EMA_CONFIRM_BARS) +

         ",\"ema10_confirm_long\":"   + (ema10_confirm_long ? "true" : "false") +

         ",\"ema10_confirm_short\":"  + (ema10_confirm_short ? "true" : "false") +

         ",\"ema_slope\":"            + str.tostring(ema_slope, "#.###") +

         ",\"ema_20_h4\":"            + str.tostring(ema_h4, "#.#####") +

         ",\"ema_20_h4_dir\":\""      + (h4_up ? "RISING" : h4_dn ? "FALLING" : "FLAT") + "\"" +

         ",\"adx_14\":"               + str.tostring(adx_val, "#.##") +

         ",\"atr_14\":"               + str.tostring(atr_val, "#.#####") +

         ",\"overextension_ratio\":"  + str.tostring(oe_ratio, "#.###") +

         ",\"trigger_window_bars\":"  + str.tostring(TRIGGER_WIN) +

         ",\"strategy_state\":\""     + (state == S_PLONG ? "PENDING_LONG" : "PENDING_SHORT") + "\"" +

         ",\"campaign\":\""           + CAMPAIGN + "\"" +

         "}"

    alert(p, alert.freq_once_per_bar_close)



// --- Trail update alert ---

var float prev_stop = na

if (state == S_LONG or state == S_SHORT) and not na(cur_stop) and cur_stop != nz(prev_stop)

    string tp = "{" +

         "\"webhook_secret\":\""      + WH_SECRET + "\"" +

         ",\"strategy_name\":\""      + STRAT_NAME + "\"" +

         ",\"strategy_version\":\""   + STRAT_VER + "\"" +

         ",\"action\":\"MODIFY_SL\"" +

         ",\"symbol\":\"EURUSD\"" +

         ",\"side\":\""               + (state == S_LONG ? "BUY" : "SELL") + "\"" +

         ",\"old_stop\":"             + str.tostring(nz(prev_stop), "#.#####") +

         ",\"new_stop\":"             + str.tostring(cur_stop, "#.#####") +

         ",\"best_close\":"           + str.tostring(best_cl, "#.#####") +

         ",\"trail_ema\":"            + str.tostring(trail_ema, "#.#####") +

         ",\"trail_ema_period\":"     + str.tostring(TRAIL_EMA_PERIOD) +

         ",\"bars_since_entry\":"     + str.tostring(pos_bars) +

         ",\"campaign\":\""           + CAMPAIGN + "\"" +

         "}"

    alert(tp, alert.freq_once_per_bar_close)



prev_stop := cur_stop



// --- Cancel alert ---

if evt_cancel

    string cp = "{" +

         "\"webhook_secret\":\""      + WH_SECRET + "\"" +

         ",\"strategy_name\":\""      + STRAT_NAME + "\"" +

         ",\"strategy_version\":\""   + STRAT_VER + "\"" +

         ",\"action\":\"CANCEL_ORDER\"" +

         ",\"symbol\":\"EURUSD\"" +

         ",\"side\":\""               + evt_side + "\"" +

         ",\"cancel_reason\":\"TRIGGER_WINDOW_EXPIRED\"" +

         ",\"bars_elapsed\":"         + str.tostring(TRIGGER_WIN) +

         ",\"campaign\":\""           + CAMPAIGN + "\"" +

         "}"

    alert(cp, alert.freq_once_per_bar_close)



// --- Time stop alert ---

if evt_tstop

    string xp = "{" +

         "\"webhook_secret\":\""      + WH_SECRET + "\"" +

         ",\"strategy_name\":\""      + STRAT_NAME + "\"" +

         ",\"strategy_version\":\""   + STRAT_VER + "\"" +

         ",\"action\":\"CLOSE_POSITION\"" +

         ",\"symbol\":\"EURUSD\"" +

         ",\"side\":\""               + evt_side + "\"" +

         ",\"close_reason\":\"TIME_STOP\"" +

         ",\"bars_held\":"            + str.tostring(pos_bars) +

         ",\"close_price\":"          + str.tostring(close, "#.#####") +

         ",\"campaign\":\""           + CAMPAIGN + "\"" +

         "}"

    alert(xp, alert.freq_once_per_bar_close)



// --- Stagnation exit alert ---

if evt_stag

    string sgp = "{" +

         "\"webhook_secret\":\""      + WH_SECRET + "\"" +

         ",\"strategy_name\":\""      + STRAT_NAME + "\"" +

         ",\"strategy_version\":\""   + STRAT_VER + "\"" +

         ",\"action\":\"CLOSE_POSITION\"" +

         ",\"symbol\":\"EURUSD\"" +

         ",\"side\":\""               + evt_side + "\"" +

         ",\"close_reason\":\"STAG_EXIT\"" +

         ",\"bars_held\":"            + str.tostring(pos_bars) +

         ",\"peak_favorable\":"       + str.tostring(peak_fav, "#.#####") +

         ",\"stag_threshold\":"       + str.tostring(STAG_ATR * nz(entry_atr), "#.#####") +

         ",\"close_price\":"          + str.tostring(close, "#.#####") +

         ",\"campaign\":\""           + CAMPAIGN + "\"" +

         "}"

    alert(sgp, alert.freq_once_per_bar_close)



// =============================================================================

// SECTION 18: VISUAL ANNOTATIONS

// =============================================================================



plotshape(sig_long, "LONG IRB", shape.triangleup, location.belowbar,

     color.new(color.green, 0), size = size.small)

plotshape(sig_short, "SHORT IRB", shape.triangledown, location.abovebar,

     color.new(color.red, 0), size = size.small)



plot(state == S_LONG or state == S_SHORT ? cur_stop : na,

     "Trail Stop", color.new(color.orange, 0), 1, plot.style_stepline)



bgcolor(not warmup_ok ? color.new(color.gray, 90) : na, title = "Warmup Zone")



// =============================================================================

// END OF STRATEGY

// =============================================================================
