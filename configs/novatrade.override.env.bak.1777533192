# NovaTrade local overrides — values here OVERRIDE /etc/novacore/novatrade.env
# Use when /etc is read-only (container/sandbox).

# OANDA Demo-1: .sim suffix required for symbol resolution
FTMO_SYMBOL_SUFFIX=.sim

# --- Launch Mode (2026-04-14) ---
# active_ready: external confirmations are optional (CONDITIONALLY_READY accepted)
# Prevents service crash from missing confirmation env vars.
NOVATRADE_LAUNCH_MODE=active_ready

# --- MetaAPI Region ---
# Accounts are provisioned on london — verified via setup connect test
# (5b9718fc on 2026-04-07, 68b8a885 on 2026-04-13, d2e8a7fd on 2026-04-28)
METAAPI_REGION=london

# --- MetaAPI Account (April 2026) ---
# OANDA-Demo-1 trial #3 (login 1600127349, $100k FTMO Free Trial 1-Step, deployed 2026-04-28)
METAAPI_ACCOUNT_ID=d2e8a7fd-6b81-422b-9ca8-6fad93c959cf

# --- Operator Confirmation (2026-04-07, refreshed 2026-04-14) ---
NOVATRADE_CONFIRM_ACTIVE_DEMO=true
NOVATRADE_CONFIRM_PINE_COMPILED=true
NOVATRADE_CONFIRM_TV_BACKTEST=true
NOVATRADE_CONFIRM_WEBHOOK_URL=true
NOVATRADE_WEBHOOK_SECRET=novacore-ftmo-demo-2026
