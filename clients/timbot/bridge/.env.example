# TIMBOT webhook bridge — copy to .env and fill in. .env is gitignored.

# Shared secret. Must match the "secret" field in the TradingView alert JSON.
# Generate a long random string, e.g.:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TIMBOT_WEBHOOK_SECRET=CHANGE_ME

# MetaApi credentials (from app.metaapi.cloud)
METAAPI_TOKEN=CHANGE_ME
METAAPI_ACCOUNT_ID=CHANGE_ME
METAAPI_REGION=new-york

# Symbol as the MT5 demo broker names gold (XAUUSD / GOLD / XAUUSD.r ...)
TIMBOT_SYMBOL=XAUUSD

# Lot opened for a full strategy position. Partials scale proportionally.
TIMBOT_BASE_LOT=0.10

# Bind address. 0.0.0.0:8080 so TradingView can reach it.
TIMBOT_BIND_HOST=0.0.0.0
TIMBOT_BIND_PORT=8080

# DRY_RUN=true logs intended trades but does NOT call MetaApi. Set false to go live.
TIMBOT_DRY_RUN=true
