# Discord throwaway-account user token (selfbot). NEVER commit the real .env.
DISCORD_USER_TOKEN=

# LLM backend: "cli" (default — uses Claude Code subscription via `claude` CLI)
#              "sdk" (requires ANTHROPIC_API_KEY below)
LLM_BACKEND=cli

# Only set if LLM_BACKEND=sdk:
# ANTHROPIC_API_KEY=

# MetaApi cloud demo (FRESH account — must NOT be the vault_native account)
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
METAAPI_REGION=new-york

# Mode: paper | live
EXECUTION_MODE=paper
