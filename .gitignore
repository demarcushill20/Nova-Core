# Python
__pycache__/
*.py[cod]
*.so
.venv/

# Runtime directories — all contents are transient; keep .gitkeep placeholders
TASKS/*
!TASKS/.gitkeep
OUTPUT/*
!OUTPUT/.gitkeep
WORK/*
!WORK/.gitkeep
STATE/*
!STATE/.gitkeep
!STATE/tools_registry.json

# Runtime artifacts
HEARTBEAT.md

# Logs
LOGS/

# Environment
*.env
.env

# MCP config (contains API tokens)
.mcp.json

# Google Workspace credentials
.config/nova-core/google/

# Playwright MCP cache
.playwright-mcp/

# Runtime data
data/

# Test/coverage artifacts
.coverage
.deepeval/
.hypothesis/

# Claude Code ephemeral
.claude/worktrees/
.bak/

# OS
.DS_Store
