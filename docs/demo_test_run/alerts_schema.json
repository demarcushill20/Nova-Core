{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "novatrade-irb-alert-v5.0.0",
  "title": "NovaTrade Rob Hoffman IRB — Alert Payload Contract",
  "description": "JSON schema for alert payloads emitted by IRB v5.0.0 (full-Python M5 pipeline). Consumed by the NovaTrade Trading Agent. Features EMA stack filter, EMA 10 close confirmation, and EMA-based trailing stop.",
  "phase": "5 (Full-Python Live Pipeline)",
  "date": "2026-03-26",
  "strategy_spec_version": "5.0.0",
  "input_parameters": {
    "EMA_CONFIRM_BARS": 3,
    "TRAIL_EMA_PERIOD": 40
  },

  "oneOf": [
    { "$ref": "#/$defs/signal_alert" },
    { "$ref": "#/$defs/trail_alert" },
    { "$ref": "#/$defs/cancel_alert" },
    { "$ref": "#/$defs/close_alert" }
  ],

  "$defs": {
    "signal_alert": {
      "type": "object",
      "description": "Emitted when an IRB signal fires (PLACE_STOP_ORDER) or replaces a pending order (REPLACE_STOP_ORDER). Trading Agent should place or replace the pending stop order.",
      "required": [
        "strategy_name", "strategy_version", "action", "signal_type",
        "irb_type", "symbol", "broker_symbol", "timeframe", "side",
        "order_type", "entry_price", "stop_loss", "stop_distance_pips",
        "volume", "risk_dollars", "bar_close_time", "bar_ohlc_o",
        "bar_ohlc_h", "bar_ohlc_l", "bar_ohlc_c", "irb_range",
        "ema_10_h1", "ema_20_h1", "ema_50_h1", "trail_ema",
        "trail_ema_period", "ema_stack_h1", "ema_confirm_bars",
        "ema10_confirm_long", "ema10_confirm_short",
        "ema_slope", "ema_20_h4", "ema_20_h4_dir",
        "adx_14", "atr_14", "overextension_ratio", "trigger_window_bars",
        "strategy_state", "campaign"
      ],
      "properties": {
        "strategy_name":        { "type": "string", "const": "Rob Hoffman IRB" },
        "strategy_version":     { "type": "string", "const": "5.0.0" },
        "action":               { "type": "string", "enum": ["PLACE_STOP_ORDER", "REPLACE_STOP_ORDER"] },
        "signal_type":          { "type": "string", "enum": ["LONG_IRB", "SHORT_IRB"] },
        "irb_type":             { "type": "string", "enum": ["UPTREND_IRB", "DOWNTREND_IRB"] },
        "symbol":               { "type": "string", "const": "EURUSD" },
        "broker_symbol":        { "type": "string", "const": "EURUSD.sim" },
        "timeframe":            { "type": "string", "const": "H1" },
        "side":                 { "type": "string", "enum": ["BUY", "SELL"] },
        "order_type":           { "type": "string", "enum": ["BUY_STOP", "SELL_STOP"] },
        "entry_price":          { "type": "number", "description": "Stop order trigger price: IRB extreme ± 1 pip" },
        "stop_loss":            { "type": "number", "description": "SL price: IRB opposite side ± 1 pip. Authoritative." },
        "stop_distance_pips":   { "type": "number", "description": "Distance from entry to SL in pips" },
        "volume":               { "type": "number", "description": "Risk-based lot size, clamped [0.01, 1.00]" },
        "risk_dollars":         { "type": "number", "description": "Dollar risk = equity * 0.01" },
        "bar_close_time":       { "type": "integer", "description": "Bar close time as Unix ms" },
        "bar_ohlc_o":           { "type": "number" },
        "bar_ohlc_h":           { "type": "number" },
        "bar_ohlc_l":           { "type": "number" },
        "bar_ohlc_c":           { "type": "number" },
        "irb_range":            { "type": "number", "description": "IRB candle range (high - low)" },
        "ema_10_h1":            { "type": "number", "description": "EMA(10) on H1 close" },
        "ema_20_h1":            { "type": "number", "description": "EMA(20) on H1 close" },
        "ema_50_h1":            { "type": "number", "description": "EMA(50) on H1 close" },
        "trail_ema":            { "type": "number", "description": "EMA used for trailing stop" },
        "trail_ema_period":     { "type": "integer", "description": "Period of the trailing stop EMA (input parameter)" },
        "ema_stack_h1":         { "type": "string", "enum": ["BULL", "BEAR", "MIXED"], "description": "EMA stack alignment: BULL = 10>20>50, BEAR = 10<20<50" },
        "ema_confirm_bars":     { "type": "integer", "description": "Number of bars for EMA 10 close confirmation (input parameter)" },
        "ema10_confirm_long":   { "type": ["boolean", "string"], "description": "Whether last N bars closed above EMA 10" },
        "ema10_confirm_short":  { "type": ["boolean", "string"], "description": "Whether last N bars closed below EMA 10" },
        "ema_slope":            { "type": "number", "description": "ATR-normalized EMA slope" },
        "ema_20_h4":            { "type": "number" },
        "ema_20_h4_dir":        { "type": "string", "enum": ["RISING", "FALLING", "FLAT"] },
        "adx_14":               { "type": "number" },
        "atr_14":               { "type": "number" },
        "overextension_ratio":  { "type": "number", "description": "bar_range / ATR(14)" },
        "trigger_window_bars":  { "type": "integer", "const": 20 },
        "strategy_state":       { "type": "string", "enum": ["PENDING_LONG", "PENDING_SHORT"] },
        "campaign":             { "type": "string", "const": "ftmo-free-trial-march-2026" }
      },
      "additionalProperties": false
    },

    "trail_alert": {
      "type": "object",
      "description": "Emitted when the EMA-based trailing stop tightens. Trading Agent should modify the SL on the open position.",
      "required": [
        "strategy_name", "strategy_version", "action", "symbol", "side",
        "old_stop", "new_stop", "best_close", "trail_ema", "trail_ema_period",
        "bars_since_entry", "campaign"
      ],
      "properties": {
        "strategy_name":    { "type": "string", "const": "Rob Hoffman IRB" },
        "strategy_version": { "type": "string", "const": "5.0.0" },
        "action":           { "type": "string", "const": "MODIFY_SL" },
        "symbol":           { "type": "string", "const": "EURUSD" },
        "side":             { "type": "string", "enum": ["BUY", "SELL"] },
        "old_stop":         { "type": "number" },
        "new_stop":         { "type": "number", "description": "Authoritative new SL level (from EMA trail)" },
        "best_close":       { "type": "number", "description": "Highest (long) or lowest (short) close since entry" },
        "trail_ema":        { "type": "number", "description": "Current trailing stop EMA value" },
        "trail_ema_period": { "type": "integer", "description": "Period of the trailing stop EMA" },
        "bars_since_entry": { "type": "integer" },
        "campaign":         { "type": "string", "const": "ftmo-free-trial-march-2026" }
      },
      "additionalProperties": false
    },

    "cancel_alert": {
      "type": "object",
      "description": "Emitted when a pending order is canceled due to trigger window expiry.",
      "required": [
        "strategy_name", "strategy_version", "action", "symbol", "side",
        "cancel_reason", "bars_elapsed", "campaign"
      ],
      "properties": {
        "strategy_name":    { "type": "string", "const": "Rob Hoffman IRB" },
        "strategy_version": { "type": "string", "const": "5.0.0" },
        "action":           { "type": "string", "const": "CANCEL_ORDER" },
        "symbol":           { "type": "string", "const": "EURUSD" },
        "side":             { "type": "string", "enum": ["BUY", "SELL"] },
        "cancel_reason":    { "type": "string", "const": "TRIGGER_WINDOW_EXPIRED" },
        "bars_elapsed":     { "type": "integer" },
        "campaign":         { "type": "string", "const": "ftmo-free-trial-march-2026" }
      },
      "additionalProperties": false
    },

    "close_alert": {
      "type": "object",
      "description": "Emitted when a time stop fires. Trading Agent should close the open position at market.",
      "required": [
        "strategy_name", "strategy_version", "action", "symbol", "side",
        "close_reason", "bars_held", "close_price", "campaign"
      ],
      "properties": {
        "strategy_name":    { "type": "string", "const": "Rob Hoffman IRB" },
        "strategy_version": { "type": "string", "const": "5.0.0" },
        "action":           { "type": "string", "const": "CLOSE_POSITION" },
        "symbol":           { "type": "string", "const": "EURUSD" },
        "side":             { "type": "string", "enum": ["BUY", "SELL"] },
        "close_reason":     { "type": "string", "const": "TIME_STOP" },
        "bars_held":        { "type": "integer" },
        "close_price":      { "type": "number" },
        "campaign":         { "type": "string", "const": "ftmo-free-trial-march-2026" }
      },
      "additionalProperties": false
    }
  }
}
