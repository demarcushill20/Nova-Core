[Unit]
Description=NovaCore Watcher/Dispatcher (TASKS -> Claude)
After=network-online.target

[Service]
Type=simple
User=nova
WorkingDirectory=/home/nova/nova-core
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /home/nova/nova-core/watcher.py
Restart=always
RestartSec=3
EnvironmentFile=/etc/novacore/telegram.env

# --- Security hardening (Phase 1.3) ---
# Filesystem restrictions
ProtectSystem=strict
# ProtectHome relaxed: Claude CLI needs ~/.claude, ~/.config, etc.
ProtectHome=no
ReadWritePaths=/home/nova/nova-core
ReadWritePaths=/home/nova/nova-vault
ReadWritePaths=/tmp
ReadOnlyPaths=/etc/novacore
PrivateTmp=yes
PrivateDevices=yes

# Privilege restrictions
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=

# System call filtering
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @clock @module @raw-io @obsolete @debug

# Namespace / kernel restrictions
# RestrictNamespaces relaxed: watcher spawns Claude CLI subprocesses
RestrictNamespaces=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
# ProtectProc/ProcSubset relaxed: Claude subprocess needs /proc access
ProtectProc=default
RestrictRealtime=yes
LockPersonality=yes

# Network (required for Claude CLI + APIs)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Resource limits
MemoryMax=4G
TasksMax=512
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
