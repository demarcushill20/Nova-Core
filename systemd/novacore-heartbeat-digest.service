[Unit]
Description=Nova-Core Heartbeat Digest (twice daily)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/nova/nova-core/scripts/heartbeat_digest.py
WorkingDirectory=/home/nova/nova-core
User=nova
EnvironmentFile=/etc/novacore/telegram.env
TimeoutStartSec=60

# Security hardening (matches novacore-report.service pattern)
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/nova/nova-core
ReadWritePaths=/tmp
ReadOnlyPaths=/etc/novacore
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=default
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
