[Unit]
Description=NovaTrade Risk State Writer (defense-in-depth backup)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/nova/nova-core/scripts/risk_state_cron.py
WorkingDirectory=/home/nova/nova-core
User=nova
StandardOutput=append:/home/nova/nova-core/LOGS/risk_state_cron.log
StandardError=append:/home/nova/nova-core/LOGS/risk_state_cron.log
TimeoutStartSec=120

# --- Security hardening ---
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/nova/nova-core
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=32
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
