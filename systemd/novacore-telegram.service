[Unit]
Description=NovaCore Telegram Bridge (Telegram -> TASKS)
After=network.target

[Service]
Type=simple
User=nova
WorkingDirectory=/home/nova/nova-core
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/novacore/telegram.env
ExecStart=/home/nova/nova-core/.venv/bin/python /home/nova/nova-core/telegram_bot.py
Restart=always
RestartSec=10
TimeoutStopSec=20

# --- Security hardening (Phase 1.3) ---
# Filesystem restrictions
ProtectSystem=strict
# ProtectHome relaxed: bot needs ~/.claude, ~/.config, etc.
ProtectHome=no
ReadWritePaths=/home/nova/nova-core
ReadWritePaths=/home/nova/nova-vault
ReadWritePaths=/tmp
ReadOnlyPaths=/etc/novacore
PrivateTmp=yes
PrivateDevices=yes

# Privilege restrictions
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=

# System call filtering — disabled because telegram bot spawns Claude CLI
# (Node.js subprocess) which needs syscalls outside @system-service whitelist.
# Other hardening (NoNewPrivileges, CapabilityBoundingSet, ProtectSystem) still active.
# SystemCallFilter=@system-service
# SystemCallFilter=~@mount @reboot @swap @clock @module @raw-io @obsolete @debug

# Namespace / kernel restrictions
RestrictNamespaces=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=default
RestrictRealtime=yes
LockPersonality=yes

# Network (required for Telegram API + Anthropic API)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Resource limits
MemoryMax=2G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
